{
  "name": "devswarm",
  "version": "0.1.0",
  "description": "VS Code-like IDE built with Electron and React",
  "main": "dist/main.cjs",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "npm run build:main && concurrently \"python backend/api_server.py\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "backend": "python backend/api_server.py",
    "frontend": "vite",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:main": "tsc src/main.ts src/preload.ts --outDir dist --module commonjs --target es2020 --skipLibCheck --allowSyntheticDefaultImports --esModuleInterop --moduleResolution node --declaration false && move dist\\main.js dist\\main.cjs && move dist\\preload.js dist\\preload.cjs",
    "build": "npm run build:main && npm run build:vite && electron-builder",
    "build:vite": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@monaco-editor/react": "^4.5.0",
    "reactflow": "^11.10.0",
    "lucide-react": "^0.263.1",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.54.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.devswarm.app",
    "productName": "DevSwarm",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "frontend/index.html"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}